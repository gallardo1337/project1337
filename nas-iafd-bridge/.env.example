# Mindestens 32 Zeichen. Empfohlen: `openssl rand -hex 32`
IAFD_BRIDGE_SECRET=

# Nur für direkten Zugriff vom NAS selbst. Der Cloudflare-Tunnel kann den
# Container im Docker-Netz als http://iafd-bridge:43137 erreichen.
IAFD_BRIDGE_BIND=127.0.0.1

IAFD_NAVIGATION_TIMEOUT_MS=35000
IAFD_CHALLENGE_WAIT_MS=20000
IAFD_CACHE_TTL_MS=600000
IAFD_MAX_REQUESTS_PER_MINUTE=20
IAFD_HEADLESS=false
